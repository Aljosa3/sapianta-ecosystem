#cloud-config
# G77-256LJ stable-checkout WRONG_SCOPE bootstrap. It invokes the operation-local
# projection of the existing FM adapter entrypoint; it does not contain or create
# Human operational authority.
users: []
disable_root: false
ssh_pwauth: false
runcmd:
  - |
    set -eu
    export PYTHONDONTWRITEBYTECODE=1
    mkdir -p /mnt/aigol /mnt/dp-harness /mnt/g77-harness /mnt/g77-evidence
    mount -t 9p -o trans=virtio,version=9p2000.L,ro aigol_checkout /mnt/aigol
    mount -t 9p -o trans=virtio,version=9p2000.L,ro fm_harness /mnt/dp-harness
    mount -t 9p -o trans=virtio,version=9p2000.L,ro g77_harness /mnt/g77-harness
    mount -t 9p -o trans=virtio,version=9p2000.L g77_evidence /mnt/g77-evidence
    echo G77_256FM_BOOT_MARKER=PASS
    set +e
    /usr/bin/python3 /mnt/dp-harness/G77_256FM_WRONG_ATTEMPT_VECTOR_ADAPTER_V1.py a59efdf4166fbc9c013a7ad7ddb23782d2fc7bc5873792960ec45b789e2df44c 95ca9b753b2e4256b6530652d5a6e2a8220fed68c52f774928e1e39721f4ca67 ea643f0e75665dd11574f5315aa947cd04e59d76 91e58cab951a52959304a965ab465c77dfe0694a 4e5d01699796d4bb451818408f7cd6a080b6d55fde518df8a9dd2acd3f1a73bb
    fm_status=$?
    set -e
    echo G77_256FM_HARNESS_EXIT_STATUS=$fm_status
    sync
    poweroff -f
