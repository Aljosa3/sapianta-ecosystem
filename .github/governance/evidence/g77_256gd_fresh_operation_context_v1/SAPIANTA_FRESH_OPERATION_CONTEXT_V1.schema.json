{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SAPIANTA_FRESH_OPERATION_CONTEXT_V1.schema.json",
  "additionalProperties": false,
  "properties": {
    "authorization_binding_policy": {"type": "object"},
    "candidate_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "canonical_argv": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "canonical_argv_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "constitutional_anchor_head": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "context_schema_version": {"const": "1.0.0"},
    "context_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "generation_identity": {"pattern": "^G77_256[A-Z0-9]{2,32}_[A-Z0-9_]+$", "type": "string"},
    "guest_context_path": {"const": "/mnt/g77-evidence/SAPIANTA_FRESH_OPERATION_CONTEXT_V1.json"},
    "guest_fixture_root": {"type": "string"},
    "guest_output_relative_paths": {
      "items": {"pattern": "^[A-Z0-9_]+\\.(json|jsonl)$", "type": "string"},
      "maxItems": 8,
      "minItems": 8,
      "type": "array",
      "uniqueItems": true
    },
    "identity_namespace_prefix": {"pattern": "^G77_256[A-Z0-9]{2,32}$", "type": "string"},
    "operation_evidence_root": {"type": "string"},
    "operation_identity": {"pattern": "^G77_256[A-Z0-9]{2,32}_[A-Z0-9_]+$", "type": "string"},
    "overlay_path": {"type": "string"},
    "post_receipt_path": {"type": "string"},
    "pre_receipt_path": {"type": "string"},
    "qemu_executable_base_seed_checkout_bindings": {"type": "object"},
    "receipt_parent": {"type": "string"},
    "repository_head": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "repository_tree": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "runtime_export_root": {"type": "string"},
    "runtime_manifest_path": {"type": "string"},
    "serial_path": {"type": "string"},
    "transient_root": {"type": "string"},
    "wrapper_fc_er_che_schema_hashes": {
      "additionalProperties": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
      "minProperties": 1,
      "type": "object"
    }
  },
  "required": [
    "context_schema_version",
    "generation_identity",
    "operation_identity",
    "identity_namespace_prefix",
    "repository_head",
    "repository_tree",
    "constitutional_anchor_head",
    "operation_evidence_root",
    "transient_root",
    "overlay_path",
    "serial_path",
    "receipt_parent",
    "pre_receipt_path",
    "post_receipt_path",
    "runtime_export_root",
    "runtime_manifest_path",
    "guest_context_path",
    "guest_output_relative_paths",
    "guest_fixture_root",
    "canonical_argv",
    "canonical_argv_sha256",
    "authorization_binding_policy",
    "candidate_manifest_sha256",
    "wrapper_fc_er_che_schema_hashes",
    "qemu_executable_base_seed_checkout_bindings",
    "context_sha256"
  ],
  "title": "SAPIANTA_FRESH_OPERATION_CONTEXT_V1",
  "type": "object"
}
